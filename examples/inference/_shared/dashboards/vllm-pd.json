  "timezone": "browser",
  "title": "vLLM PD disaggregation: latency, KV transfer, EFA and joint-SLO goodput",
  "uid": "vllm-pd-efa",
  "version": 1,
  "weekStart": "",
  "description": "vLLM prefill/decode disaggregation (and its aggregated baseline): engine latency histograms, queue depth, KV cache use, NIXL KV transfer, EFA RDMA counters per node, and the joint-SLO goodput of scored runs. Needs the vllm and distai-pd-score scrape jobs in examples/inference/_shared/dashboards/scrape-configs.yaml and the efa-exporter job from awsome-distributed-ai eks-managed-observability.",
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Request latency (engine-side histograms)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "TTFT p50/p90/p99 by role",
      "description": "histogram_quantile over vllm:time_to_first_token_seconds_bucket, per component. In disaggregated serving a prefill engine times its own single-token prefill, and a decode engine times the first token after it pulled the KV cache, so neither alone is the client-side TTFT; the scorer's TTFT (measured by the load generator) is.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, component) (rate(vllm:time_to_first_token_seconds_bucket{job=\"vllm\",namespace=\"$namespace\",release=~\"$release\"}[$__rate_interval])))",
          "legendFormat": "{{component}} p50",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (le, component) (rate(vllm:time_to_first_token_seconds_bucket{job=\"vllm\",namespace=\"$namespace\",release=~\"$release\"}[$__rate_interval])))",
          "legendFormat": "{{component}} p90",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, component) (rate(vllm:time_to_first_token_seconds_bucket{job=\"vllm\",namespace=\"$namespace\",release=~\"$release\"}[$__rate_interval])))",
          "legendFormat": "{{component}} p99",
          "refId": "C",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
