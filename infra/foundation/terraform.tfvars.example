# Copy to terraform.tfvars and replace every value. The values below are
# documentation placeholders (RFC 5737 addresses, the 111122223333 example
# account), not working values.
name   = "example-cell"
region = "us-east-1"

endpoint_public_access_cidrs = ["192.0.2.0/24"]

admin_principal_arns = [
  "arn:aws:iam::111122223333:role/ExampleAdmin",
]

# Optional.
# kubernetes_version = "1.37"
# vpc_cidr           = "10.0.0.0/16"
# single_nat_gateway = true
#
# system_node_group = {
#   instance_types = ["m7i.large"]
#   size           = 2
# }
#
# Hub cells only: create the managed Argo CD capability.
# argocd = {
#   idc_instance_arn = "arn:aws:sso:::instance/ssoins-0123456789abcdef"
#   idc_region       = "us-east-1"
#   role_mappings = [
#     { role = "ADMIN", group_ids = ["00000000-0000-0000-0000-000000000000"] },
#     { role = "VIEWER", group_ids = ["11111111-1111-1111-1111-111111111111"] },
#   ]
# }
#
# Cells that use sharedfs per-team checkpoint and shared dataset
# directories (issue #18). deployment_type/storage_capacity_gib default to
# the cheapest real deployment type (SCRATCH_2, 1200 GiB) if omitted.
# shared_fsx_lustre = {
#   deployment_type      = "SCRATCH_2"
#   storage_capacity_gib = 1200
# }

tags = {
  "distai-platform/cell" = "example-cell"
}

# Optional cost guardrail (issue #95): a light verification cell's own
# AWS Budgets limit and the addresses that should be notified at 80% and
# 100% of it. Both default to "off" (null / []); uncomment and pass your
# own values, never commit a real email address here.
# budget_limit_usd           = 10
# budget_notification_emails = ["you@example.com"]
